# VT Platform frontend — environment template.
# Copy to `.env.local` for local development. Only variables prefixed with
# `VITE_` are exposed to the client bundle (never put secrets here).

# Base URL of the versioned REST API (API-000 §2 — URI versioning).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Client-side request timeout in milliseconds (API-000 §19.2 retry strategy).
VITE_API_TIMEOUT=15000

# Human-readable environment name, surfaced in diagnostics/error reports.
VITE_APP_ENV=development

# Origin the public site is served from — the host every canonical URL, Open
# Graph URL and sitemap entry is built on. It must match the backend's
# FRONTEND_BASE_URL: the two disagreeing means the sitemap advertises one address
# while the page it points at declares another canonical, and search resolves the
# contradiction by picking one on its own.
#
# Left as the production host on purpose. A canonical is a claim about where a
# page really lives, so shipping one that says `localhost` is worse than a stale
# one; override it locally only if you are actually inspecting the tags.
VITE_SITE_URL=https://vzlettalantov.by
