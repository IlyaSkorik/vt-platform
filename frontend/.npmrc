# pnpm configuration — see https://pnpm.io/npmrc
# Install peer dependencies automatically (matches the intent of our pinned stack).
auto-install-peers=true
# Do not fail installs on benign peer-range mismatches (e.g. plugins declaring a
# newer Vite major than the one this project intentionally pins). Real conflicts
# still surface as warnings and are reviewed.
strict-peer-dependencies=false
# Deterministic, CI-friendly installs.
resolution-mode=highest
