file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependencies point inward; domain knows nothing about Django/DRF/PostgreSQL/HTTP. Enables testability and infrastructure replaceability."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_solid_principles", "label": "SOLID Principles", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-responsibility, open/closed, Liskov, interface-segregation, dependency-inversion applied across modules."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_domain_driven_design", "label": "Domain-Driven Design", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System decomposed into bounded contexts with a shared ubiquitous language."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_api_first", "label": "API First", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every capability exposed via a versioned, contract-first OpenAPI; SPA is just one consumer."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_mobile_first", "label": "Mobile First", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI designed smallest-viewport-first; performance budgets assume mid-range mobile."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_security_by_design", "label": "Security by Design", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Threat modeling, least privilege, secure defaults, defense in depth from day one."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_privacy_by_design", "label": "Privacy by Design", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data minimization, purpose limitation, consent tracking, minor-data protection are structural."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_event_driven_integration", "label": "Event-Driven Integration", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State changes emit domain events; cross-context reactions handled asynchronously via Redis/Celery."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_modular_monolith", "label": "Modular Monolith", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single deployable Django app partitioned into strict bounded-context modules; DDD boundaries without microservice ops overhead."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_transactional_outbox", "label": "Transactional Outbox", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain events persisted in the same transaction as state changes, relayed to Redis \u2014 at-least-once delivery without dual-write inconsistency."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_schema_per_context", "label": "Schema-per-Context", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each bounded context owns its tables under a dedicated PostgreSQL schema; cross-schema FKs avoided, references by ID."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_rbac_scoping", "label": "RBAC + Scoping", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role-based access control refined with scope/tenancy and light ABAC; deny by default, least privilege."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_principle_jwt_authentication", "label": "JWT Authentication", "file_type": "rationale", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short-lived access token + rotating refresh token; reuse detection invalidates the token family."}, {"id": "docs_architecture_arch_001_vt_platform_architecture_adr_adr_0001", "label": "ADR-0001 \u00b7 Adopt Modular Monolith over microservices for v1", "file_type": "concept", "source_file": "docs/architecture/ARCH-001-vt-platform-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "