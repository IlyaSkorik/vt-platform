# VT Platform backend — example environment configuration.
# Copy to `.env` for local development. NEVER commit real secrets (ARCH-001 §16.3).
# All values are read through the typed Pydantic settings (config/settings/env.py).

# --- Core Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Localization (timezone UTC, primary language ru) ---
DJANGO_TIME_ZONE=UTC
DJANGO_LANGUAGE_CODE=ru

# --- CORS (locked to known origins) ---
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
POSTGRES_DB=vt_platform
POSTGRES_USER=vt_platform
POSTGRES_PASSWORD=vt_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT (short access token, rotating refresh) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
