# VT Platform backend — example environment configuration.
# Copy to `.env` for local development. NEVER commit real secrets (ARCH-001 §16.3).
# All values are read through the typed Pydantic settings (config/settings/env.py).
#
# Lines marked **REQUIRED IN PRODUCTION** have a development-friendly default that must not
# reach a deployment. Two of them are enforced: `config/settings/production.py` refuses to
# import without a real DJANGO_SECRET_KEY or an explicit DJANGO_ALLOWED_HOSTS, so a
# misconfigured container exits instead of serving traffic that only looks fine.

# --- Core Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
# **REQUIRED IN PRODUCTION.** Generate per environment and keep it in the secret store
# (OPS-008 §9): `python -c 'import secrets; print(secrets.token_urlsafe(64))'`. Rotating it
# invalidates sessions and password-reset links, and changes where *new* diploma files are
# written (OPS-007) — already-issued diplomas keep working.
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
# **REQUIRED IN PRODUCTION.** Comma-separated hostnames. Left at localhost a deployment
# answers every real request with a 400.
DJANGO_ALLOWED_HOSTS=localhost

# --- Localization (timezone UTC, primary language ru) ---
DJANGO_TIME_ZONE=UTC
DJANGO_LANGUAGE_CODE=ru

# --- CORS (locked to known origins) ---
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Web client (used to build emailed links, e.g. email verification) ---
# Also the origin every entry in the generated /sitemap.xml is built on, and the
# host advertised in /robots.txt. Must match the frontend's VITE_SITE_URL, or the
# sitemap and the pages' canonical tags will name two different sites.
# Production: FRONTEND_BASE_URL=https://vzlettalantov.by
FRONTEND_BASE_URL=http://localhost:5173

# Absolute path to the built SPA's index.html. Set it when Django serves the
# bundle: browser routes are then answered with their <head> already filled in,
# which is the only way Telegram/VK/WhatsApp link previews get a festival's name
# and poster — those crawlers fetch once and never run the app's JavaScript.
# Empty (the default, and the case while Vite serves the SPA) leaves the
# catch-all inert: unknown addresses still 404.
# Production: SPA_INDEX_PATH=/srv/vt/frontend/dist/index.html
SPA_INDEX_PATH=

# Public base URL a diploma's QR code points at (<base>/verify/<token>); its host
# is also the address printed under the code. Leave empty to reuse
# FRONTEND_BASE_URL, which keeps local prints and scans on the dev client.
# Production: DIPLOMA_VERIFICATION_BASE_URL=https://vzlettalantov.by
DIPLOMA_VERIFICATION_BASE_URL=

# Hours before an unpaid, submitted application (no payment receipt attached) is
# auto-cancelled. Lower it (e.g. 0.05 ≈ 3 min) to exercise the flow locally.
APPLICATION_PAYMENT_WINDOW_HOURS=48
# How often (minutes) the Celery Beat sweep looks for overdue unpaid applications.
APPLICATION_PAYMENT_SWEEP_MINUTES=15

# --- PostgreSQL ---
POSTGRES_DB=vt_platform
POSTGRES_USER=vt_platform
# **REQUIRED IN PRODUCTION.** docker-compose.prod.yml refuses to start without it rather than
# bringing up a database whose password is in a public example file.
POSTGRES_PASSWORD=vt_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Email / SMTP (Mailhog in local dev; a real provider in prod) ---
# In the Docker Compose network the backend reaches Mailhog by service name;
# docker-compose.yml overrides EMAIL_HOST=mailhog. For a host-run backend,
# Mailhog is published on localhost:1025.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_DEFAULT_FROM=no-reply@vzlyot-talantov.ru
# Credentials for a real provider. Empty is correct only for Mailhog, which accepts anything.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Envelope sender for mail produced in batches (submission receipts, review outcomes, the
# auto-cancellation sweep). A second mailbox is the cheapest headroom there is, because the
# provider counts its allowance *per mailbox* — so a registration rush can no longer delay
# somebody's password reset. Empty reuses EMAIL_DEFAULT_FROM, which is a correct
# single-mailbox deployment (OPS-009).
EMAIL_BULK_FROM=
# Contractual provider limits, not tuning knobs (OPS-009). Exceeding them gets outbound mail
# throttled or refused. Zero disables the limiter, which is what the test suite runs on.
EMAIL_RATE_LIMIT_PER_MINUTE=30
EMAIL_MAX_RECIPIENTS=50

# --- Object storage (OPS-007) ---
#
# Uploads and generated documents move to a bucket as soon as S3_BUCKET is set; nothing in the
# application layer knows, because every file goes through `default_storage` and every stored
# reference is whatever that storage says its URL is.
#
# **Strongly recommended in production.** Left empty, media lands on the container's own disk:
# it does not survive a redeploy, and — since a diploma is rendered by the Celery worker and
# downloaded through nginx — every container that touches a file must share one volume. The
# production compose does wire that volume up, so an empty bucket works; it just makes the
# deployment stateful, which OPS-008 §9 then has to back up.
S3_BUCKET=
S3_REGION=
# Set for an S3-compatible provider (Selectel, VK Cloud, MinIO); leave empty for AWS itself.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN or custom domain in front of the bucket. Worth it once jury video review makes egress
# the dominant cost (OPS-008 §10).
S3_CUSTOM_DOMAIN=
# Optional key prefix, so one bucket can carry several environments.
S3_LOCATION=

# Where a host keeps local copies of uploaded diploma fonts: reportlab embeds a font by opening
# a file, so a font in the bucket has to reach local disk before it can be drawn. Empty means
# the system temp directory, which is right for a single host. Point it at a shared volume for a
# container fleet, so a font is fetched once per host rather than once per container lifetime.
DIPLOMA_FONT_CACHE_DIR=

# --- JWT (short access token, rotating refresh) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Nightly database backup (OPS-001 §9) ---
#
# Read by `deploy/backup/vt-backup.sh`, not by Django — nothing in the application opens these.
#
# **Their proper home is `/etc/vt-backup.env`, not this file.** The point of a separate bucket is
# a separate key: the application's key can delete media, so everything it reaches is destroyable
# by whatever destroys the application, and a backup must not be reachable that way. Keeping the
# backup's key out of the application's environment is what makes that true rather than merely
# intended. They are named here so they are findable, and left empty on purpose.
#
# Set none of them and the script falls back to S3_BUCKET above under a `backups/db/` prefix —
# one bucket, one key, which is a worse shape but a working one.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT_URL=

# Where a failed backup reports. Without these a failure reaches only the journal, which is the
# usual way a job that stopped in March is discovered in June.
BACKUP_TELEGRAM_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
